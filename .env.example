# ERPNext 部署配置
# 复制此文件为 .env 并修改: cp .env.example .env

# 访问端口
ERPNEXT_PORT=8080

# 管理员密码 (ERPNext 后台登录)
ADMIN_PASSWORD=admin

# 数据库 root 密码
DB_PASSWORD=admin

# Frappe 框架版本
FRAPPE_VERSION=v15.98.1

# 自定义镜像名称和标签
ERPNEXT_IMAGE=erpnext-custom
ERPNEXT_IMAGE_TAG=latest

# 构建参数
PYTHON_VERSION=3.11.9
NODE_VERSION=18.20.2
