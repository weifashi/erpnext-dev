FROM python:3.11-slim

# Install Docker CLI (client only, no daemon)
RUN apt-get update -qq && \
    apt-get install -y -qq --no-install-recommends curl ca-certificates && \
    curl -fsSL https://get.docker.com | sh && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

# Install Python dependencies
RUN pip install --no-cache-dir "mcp[cli]" httpx

WORKDIR /app
COPY erpnext_mcp_server.py .

ENV MCP_TRANSPORT=sse \
    MCP_PORT=8100 \
    ERPNEXT_HOST=frontend \
    ERPNEXT_PORT=8080 \
    DEFAULT_SITE=frontend \
    COMPOSE_PROJECT=erpnext

EXPOSE 8100

CMD ["python3", "erpnext_mcp_server.py"]
